# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA_your_token_here

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Название сервиса в сообщениях и ключах
SERVICE_NAME=NovaVPN

# Юзернейм поддержки без @
SUPPORT_USERNAME=novavpn_support

# Демо-режим: кнопка «Демо-оплата» без списания звёзд (для показа бота). Для продакшена: false
DEMO_PAYMENTS=true

# Пробный период, дней (0 — отключить)
TRIAL_DAYS=3

# Бонус пригласившему за первую оплату друга, дней
REFERRAL_BONUS_DAYS=7

# Часовой пояс для дат в сообщениях
TZ_NAME=Europe/Moscow

# Файл базы данных
DB_PATH=vpn_bot.sqlite3
